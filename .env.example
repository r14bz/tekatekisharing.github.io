# Server (Vercel Environment Variables — backend only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_SESSION_SECRET=random-string-panjang

# Client / Vite (wajib untuk Supabase Realtime di browser)
# Pakai Publishable key atau legacy anon key — JANGAN service_role
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_..._atau_eyJ_anon_jwt
